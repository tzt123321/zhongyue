# ─────────────────────────────────────────────────────────────────────────────
# 众乐 (ZhongYue) — 环境变量配置
# 复制此文件为 .env 后修改对应值
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── 数据库 ────────────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=zhongyue
DB_PASSWORD=zhongyue_secret_pass
DB_NAME=zhongyue

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Elasticsearch ─────────────────────────────────────────────────────────────
ES_HOST=http://elasticsearch:9200
ES_PORT=9200

# ── 应用密钥 ─────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-use-strong-random-key

# ── 音乐文件目录 ──────────────────────────────────────────────────────────────
# 宿主机上的音乐文件夹路径，容器会自动映射到 /music
# Linux/macOS 示例：
# MUSIC_PATH=./music
# Windows Docker Desktop 示例（WSL2 或 Linux 容器模式）：
# MUSIC_PATH=F:/path/to/your/music
# 或在 .env 中直接写：MUSIC_PATH=./music（使用本地相对路径）

# ── 服务端口 ─────────────────────────────────────────────────────────────────
# Nginx 前端端口（默认 8088，避免 80 被占用）
HTTP_PORT=8088
API_PORT=7800

# ── 管理员账号 ───────────────────────────────────────────────────────────────
# 首次部署时自动创建，支持修改用户名和密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_INVITE_CODE=ADMIN2026

# ── 代理（可选，用于元数据刮削访问国际服务）─────────────────────────────
# 如果服务器在国内，需要配置代理才能刮削 Apple Music / MusicBrainz
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890

# ── 时区 ─────────────────────────────────────────────────────────────────────
TZ=Asia/Shanghai
