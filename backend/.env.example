# HarmonyBox Configuration
# Copy this file to .env and customize values

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=7777
DEBUG=false

# Database (SQLite - file path is relative to backend/ directory)
DATABASE_URL=sqlite+aiosqlite:///./data/harmonybox.db

# Security - CHANGE THIS in production!
SECRET_KEY=change-me-in-production-use-a-long-random-string

# JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Music Library
MUSIC_PATHS=/music
SCAN_ON_STARTUP=false
SCAN_INTERVAL=3600

# Streaming
ENABLE_RANGE_REQUESTS=true
BUFFER_SIZE=8192

# Metadata Scraping
ENABLE_SCRAPING=true
SCRAPE_SOURCES=musicbrainz,lastfm
